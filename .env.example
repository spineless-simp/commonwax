# Deployment configuration. Copy to .env and set real values. Local development
# does not use this file at all — `npm run dev` reads the committed .env.dev and
# talks to the services in docker-compose.dev.yml.
#
# Commonwax will not start in production with
# a default credential: POSTGRES_PASSWORD and NAVIDROME_PASSWORD have no
# fallback in docker-compose.yml, and the API refuses to boot when
# NAVIDROME_PASSWORD or PUBLIC_URL is missing under NODE_ENV=production.

POSTGRES_DB=commonwax
POSTGRES_USER=commonwax
# Required. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
NAVIDROME_USERNAME=admin
# Required. Generate with: openssl rand -base64 32
NAVIDROME_PASSWORD=

# The URL invited members will open. Invitation links are built from it.
PUBLIC_URL=http://localhost:8080

# Must be true whenever PUBLIC_URL is https://, or the session cookie is sent
# in cleartext. The API refuses to start on that combination in production.
COOKIE_SECURE=false

API_PORT=3000
WEB_PORT=8080

# Optional. A fanart.tv API key (fanart.tv/get-an-api-key) turns on artist logos
# and backgrounds. Without one no request leaves the deployment and artists fall
# back to their typeset name.
FANART_API_KEY=
