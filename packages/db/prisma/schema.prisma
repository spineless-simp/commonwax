generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum RequestStatus {
  OPEN
  CLAIMED
  FULFILLED
  CANCELLED
}

enum UploadStatus {
  STAGED
  SCANNING
  IMPORTED
  FAILED
}

enum ActivityType {
  MUSIC_ADDED
  MEMBER_JOINED
  REQUEST_CREATED
  REQUEST_CLAIMED
  REQUEST_FULFILLED
}

model User {
  id                   String          @id @default(uuid()) @db.Uuid
  email                String          @unique
  displayName          String
  passwordHash         String
  createdAt            DateTime        @default(now())
  memberships          Membership[]
  sessions             Session[]
  invitationsCreated   Invitation[]    @relation("InvitationCreator")
  invitationsAccepted  Invitation[]    @relation("InvitationAcceptor")
  uploads              UploadBatch[]
  contributions        Contribution[]
  requestedMusic       MusicRequest[]  @relation("Requester")
  claimedMusic         MusicRequest[]  @relation("Claimant")
  fulfilledMusic       MusicRequest[]  @relation("Fulfiller")
  activities           ActivityEvent[] @relation("ActivityActor")
  hiddenAlbums         HiddenAlbum[]
}

model Library {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  createdAt     DateTime        @default(now())
  memberships   Membership[]
  invitations   Invitation[]
  artists       Artist[]
  albums        Album[]
  tracks        Track[]
  uploads       UploadBatch[]
  contributions Contribution[]
  requests      MusicRequest[]
  activities    ActivityEvent[]
  hiddenAlbums  HiddenAlbum[]
}

model Membership {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  libraryId           String   @db.Uuid
  role                Role     @default(MEMBER)
  permissionOverrides Json?
  joinedAt            DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  library             Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([userId, libraryId])
  @@index([libraryId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique
  libraryId    String    @db.Uuid
  createdById  String    @db.Uuid
  acceptedById String?   @db.Uuid
  role         Role      @default(MEMBER)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  library      Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("InvitationCreator", fields: [createdById], references: [id])
  acceptedBy   User?     @relation("InvitationAcceptor", fields: [acceptedById], references: [id])

  @@index([libraryId])
}

model Artist {
  id           String   @id @default(uuid()) @db.Uuid
  libraryId    String   @db.Uuid
  navidromeId  String
  name         String
  albumCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  library      Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  albums       Album[]
  tracks       Track[]

  @@unique([libraryId, navidromeId])
  @@index([libraryId, name])
}

model Album {
  id             String         @id @default(uuid()) @db.Uuid
  libraryId      String         @db.Uuid
  artistId       String         @db.Uuid
  navidromeId    String
  title          String
  year           Int?
  genre          String?
  songCount      Int            @default(0)
  duration       Int            @default(0)
  coverArt       String?
  navidromeAdded DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  library        Library        @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  artist         Artist         @relation(fields: [artistId], references: [id])
  tracks         Track[]
  contributions  Contribution[]
  fulfilledFor   MusicRequest[] @relation("FulfilledAlbum")
  hiddenBy       HiddenAlbum[]

  @@unique([libraryId, navidromeId])
  @@index([libraryId, title])
  @@index([artistId])
}

model Track {
  id            String              @id @default(uuid()) @db.Uuid
  libraryId     String              @db.Uuid
  artistId      String              @db.Uuid
  albumId       String              @db.Uuid
  navidromeId   String
  title         String
  discNumber    Int                 @default(1)
  trackNumber   Int?
  duration      Int                 @default(0)
  suffix        String?
  contentType   String?
  bitRate       Int?
  path          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  library       Library             @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  artist        Artist              @relation(fields: [artistId], references: [id])
  album         Album               @relation(fields: [albumId], references: [id], onDelete: Cascade)
  contributions ContributionTrack[]

  @@unique([libraryId, navidromeId])
  @@index([albumId, discNumber, trackNumber])
  @@index([libraryId, title])
}

model UploadBatch {
  id           String         @id @default(uuid()) @db.Uuid
  libraryId    String         @db.Uuid
  uploaderId   String         @db.Uuid
  requestId    String?        @db.Uuid
  status       UploadStatus   @default(STAGED)
  stagingPath  String
  error        String?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?
  library      Library        @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  uploader     User           @relation(fields: [uploaderId], references: [id])
  request      MusicRequest?  @relation(fields: [requestId], references: [id])
  files        UploadFile[]
  contributions Contribution[]

  @@index([libraryId, createdAt])
}

model UploadFile {
  id                String      @id @default(uuid()) @db.Uuid
  uploadBatchId     String      @db.Uuid
  originalName      String
  stagedName        String
  canonicalPath     String?
  detectedArtist    String?
  detectedAlbum     String?
  detectedTitle     String?
  uploadBatch       UploadBatch @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)

  @@index([uploadBatchId])
}

model Contribution {
  id            String              @id @default(uuid()) @db.Uuid
  libraryId     String              @db.Uuid
  contributorId String              @db.Uuid
  uploadBatchId String              @db.Uuid
  albumId       String              @db.Uuid
  createdAt     DateTime            @default(now())
  library       Library             @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  contributor   User                @relation(fields: [contributorId], references: [id])
  uploadBatch   UploadBatch         @relation(fields: [uploadBatchId], references: [id])
  album         Album               @relation(fields: [albumId], references: [id])
  tracks        ContributionTrack[]

  @@unique([uploadBatchId, albumId])
  @@index([libraryId, createdAt])
}

model ContributionTrack {
  contributionId String       @db.Uuid
  trackId        String       @db.Uuid
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  track          Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([contributionId, trackId])
}

model MusicRequest {
  id               String         @id @default(uuid()) @db.Uuid
  libraryId        String         @db.Uuid
  artist           String
  album            String
  requesterId      String         @db.Uuid
  claimantId       String?        @db.Uuid
  fulfillerId      String?        @db.Uuid
  fulfilledAlbumId String?        @db.Uuid
  status           RequestStatus  @default(OPEN)
  createdAt        DateTime       @default(now())
  claimedAt        DateTime?
  fulfilledAt      DateTime?
  cancelledAt      DateTime?
  library          Library        @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  requester        User           @relation("Requester", fields: [requesterId], references: [id])
  claimant         User?          @relation("Claimant", fields: [claimantId], references: [id])
  fulfiller        User?          @relation("Fulfiller", fields: [fulfillerId], references: [id])
  fulfilledAlbum   Album?         @relation("FulfilledAlbum", fields: [fulfilledAlbumId], references: [id])
  uploads          UploadBatch[]

  @@index([libraryId, status, createdAt])
}

model ActivityEvent {
  id        String       @id @default(uuid()) @db.Uuid
  libraryId String       @db.Uuid
  actorId   String?      @db.Uuid
  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())
  library   Library      @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  actor     User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([libraryId, createdAt])
}

model HiddenAlbum {
  userId    String   @db.Uuid
  libraryId String   @db.Uuid
  albumId   String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
  @@index([libraryId])
}
