generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum RequestStatus {
  OPEN
  CLAIMED
  FULFILLED
}

enum UploadStatus {
  STAGED
  SCANNING
  IMPORTED
  FAILED
}

enum ActivityType {
  MUSIC_ADDED
  MEMBER_JOINED
  REQUEST_CREATED
  REQUEST_CLAIMED
  REQUEST_FULFILLED
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  email               String          @unique
  displayName         String
  passwordHash        String
  createdAt           DateTime        @default(now())
  // The picture itself, not a path: it is small, it is Commonwax's own data
  // rather than catalog media, and keeping it here means no second volume whose
  // ownership and backup story would have to be settled separately. `avatarType`
  // is the type sniffed from the bytes on upload, never the one the client
  // claimed. `avatarUpdatedAt` is what the URL is versioned on so a replaced
  // picture is not served from cache.
  avatar              Bytes?
  avatarType          String?
  avatarUpdatedAt     DateTime?
  memberships         Membership[]
  sessions            Session[]
  invitationsCreated  Invitation[]    @relation("InvitationCreator")
  invitationsAccepted Invitation[]    @relation("InvitationAcceptor")
  uploads             UploadBatch[]
  contributions       Contribution[]
  requestedMusic      MusicRequest[]  @relation("Requester")
  claimedMusic        MusicRequest[]  @relation("Claimant")
  fulfilledMusic      MusicRequest[]  @relation("Fulfiller")
  activities          ActivityEvent[] @relation("ActivityActor")
  hiddenAlbums        HiddenAlbum[]
  listeningNow        ListeningNow?
}

model Library {
  id            String              @id @default(uuid()) @db.Uuid
  name          String
  createdAt     DateTime            @default(now())
  memberships   Membership[]
  invitations   Invitation[]
  albumBindings MediaAlbumBinding[]
  trackBindings MediaTrackBinding[]
  uploads       UploadBatch[]
  contributions Contribution[]
  requests      MusicRequest[]
  activities    ActivityEvent[]
  hiddenAlbums  HiddenAlbum[]
  listeningNow  ListeningNow[]
}

model Membership {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  libraryId           String   @db.Uuid
  role                Role     @default(MEMBER)
  permissionOverrides Json?
  // Set when an admin withholds contribution from this member. It subtracts the
  // two contribution permissions from whatever their role grants rather than
  // snapshotting a permission list, so a later role change still lands.
  uploadsBlockedAt    DateTime?
  joinedAt            DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  library             Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([userId, libraryId])
  @@index([libraryId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique
  libraryId    String    @db.Uuid
  createdById  String?   @db.Uuid
  acceptedById String?   @db.Uuid
  role         Role      @default(MEMBER)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  library      Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  createdBy    User?     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy   User?     @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([libraryId])
}

// These rows are sparse Commonwax-owned identity/provenance bindings. Navidrome
// remains authoritative for whether media exists and for all current catalog data.
model MediaAlbumBinding {
  id              String              @id @default(uuid()) @db.Uuid
  libraryId       String              @db.Uuid
  navidromeId     String?
  musicBrainzId   String?
  lastKnownTitle  String              @map("title")
  lastKnownArtist String
  lastKnownYear   Int?                @map("year")
  lastKnownDuration Int?              @map("duration")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  library         Library             @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  trackBindings   MediaTrackBinding[]
  contributions   Contribution[]
  fulfilledFor    MusicRequest[]      @relation("FulfilledAlbum")
  hiddenBy        HiddenAlbum[]

  @@unique([libraryId, navidromeId])
  @@index([libraryId, musicBrainzId])
  @@map("Album")
}

model MediaTrackBinding {
  id                   String              @id @default(uuid()) @db.Uuid
  libraryId            String              @db.Uuid
  albumBindingId       String              @map("albumId") @db.Uuid
  navidromeId          String?
  musicBrainzId        String?
  isrcs                String[]            @default([])
  lastKnownTitle       String              @map("title")
  lastKnownArtist      String
  lastKnownDiscNumber  Int                 @default(1) @map("discNumber")
  lastKnownTrackNumber Int?                @map("trackNumber")
  lastKnownDuration    Int?                @map("duration")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  library              Library             @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  albumBinding         MediaAlbumBinding   @relation(fields: [albumBindingId], references: [id], onDelete: Cascade)
  contributions        ContributionTrack[]

  @@unique([libraryId, navidromeId])
  @@index([libraryId, musicBrainzId])
  @@index([albumBindingId, lastKnownDiscNumber, lastKnownTrackNumber])
  @@map("Track")
}

model UploadBatch {
  id            String         @id @default(uuid()) @db.Uuid
  libraryId     String         @db.Uuid
  uploaderId    String?        @db.Uuid
  requestId     String?        @db.Uuid
  status        UploadStatus   @default(STAGED)
  stagingPath   String
  error         String?
  createdAt     DateTime       @default(now())
  completedAt   DateTime?
  library       Library        @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  uploader      User?          @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  request       MusicRequest?  @relation(fields: [requestId], references: [id])
  files         UploadFile[]
  contributions Contribution[]

  @@index([libraryId, createdAt])
}

model UploadFile {
  id                   String      @id @default(uuid()) @db.Uuid
  uploadBatchId        String      @db.Uuid
  originalName         String
  stagedName           String
  pendingCanonicalPath String?     @map("canonicalPath")
  detectedArtist       String?
  detectedAlbum        String?
  detectedTitle        String?
  detectedDuration     Int         @default(0)
  uploadBatch          UploadBatch @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)

  @@index([uploadBatchId])
}

model Contribution {
  id             String              @id @default(uuid()) @db.Uuid
  libraryId      String              @db.Uuid
  // Null once the account behind it is erased. The contribution survives, so the
  // music keeps a provenance record; it is simply no longer anybody's name.
  contributorId  String?             @db.Uuid
  uploadBatchId  String              @db.Uuid
  albumBindingId String              @map("albumId") @db.Uuid
  createdAt      DateTime            @default(now())
  library        Library             @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  contributor    User?               @relation(fields: [contributorId], references: [id], onDelete: SetNull)
  uploadBatch    UploadBatch         @relation(fields: [uploadBatchId], references: [id])
  albumBinding   MediaAlbumBinding   @relation(fields: [albumBindingId], references: [id])
  tracks         ContributionTrack[]

  @@unique([uploadBatchId, albumBindingId], map: "Contribution_uploadBatchId_albumId_key")
  @@index([libraryId, createdAt])
}

model ContributionTrack {
  contributionId String            @db.Uuid
  trackBindingId String            @map("trackId") @db.Uuid
  contribution   Contribution      @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  trackBinding   MediaTrackBinding @relation(fields: [trackBindingId], references: [id], onDelete: Cascade)

  @@id([contributionId, trackBindingId])
}

model MusicRequest {
  id                          String             @id @default(uuid()) @db.Uuid
  libraryId                   String             @db.Uuid
  artist                      String
  album                       String
  musicBrainzReleaseGroupId   String?            @db.VarChar(36)
  year                        Int?
  requesterId                 String?            @db.Uuid
  claimantId                  String?            @db.Uuid
  fulfillerId                 String?            @db.Uuid
  fulfilledAlbumBindingId     String?            @map("fulfilledAlbumId") @db.Uuid
  status                      RequestStatus      @default(OPEN)
  createdAt                   DateTime           @default(now())
  claimedAt                   DateTime?
  fulfilledAt                 DateTime?
  library                     Library            @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  requester                   User?              @relation("Requester", fields: [requesterId], references: [id], onDelete: SetNull)
  claimant                    User?              @relation("Claimant", fields: [claimantId], references: [id], onDelete: SetNull)
  fulfiller                   User?              @relation("Fulfiller", fields: [fulfillerId], references: [id], onDelete: SetNull)
  fulfilledAlbumBinding       MediaAlbumBinding? @relation("FulfilledAlbum", fields: [fulfilledAlbumBindingId], references: [id])
  uploads                     UploadBatch[]

  @@index([libraryId, status, createdAt])
  @@index([libraryId, musicBrainzReleaseGroupId])
}

model ActivityEvent {
  id        String       @id @default(uuid()) @db.Uuid
  libraryId String       @db.Uuid
  actorId   String?      @db.Uuid
  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())
  library   Library      @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  actor     User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([libraryId, createdAt])
}

// Transient listening presence, not a play history and not catalog data: one row
// per listener holding the opaque catalog reference they are on. Navidrome still
// resolves what that reference currently is, and a row is meaningless once stale.
model ListeningNow {
  userId         String   @id @db.Uuid
  libraryId      String   @db.Uuid
  trackReference String
  startedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  library        Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId, updatedAt])
}

model HiddenAlbum {
  userId         String            @db.Uuid
  libraryId      String            @db.Uuid
  albumBindingId String            @map("albumId") @db.Uuid
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  library        Library           @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  albumBinding   MediaAlbumBinding @relation(fields: [albumBindingId], references: [id], onDelete: Cascade)

  @@id([userId, albumBindingId])
  @@index([libraryId])
}

// Artist logos and backgrounds fetched from fanart.tv. Not catalog data and not
// a binding: Navidrome still says what music exists, and every image column here
// is a cache of a third party's artwork that can be absent today and present in
// a month. Nothing in the product depends on a row existing.
//
// Keyed by the artist's name rather than a MusicBrainz id because the files in a
// collection are not required to carry one — `musicBrainzId` is the result of
// the lookup, not its input. A row with `checkedAt` set and a null
// `musicBrainzId` is a recorded miss, which is what stops an unresolvable name
// being searched again on every page load.
model ArtistArtwork {
  id             String   @id @default(uuid()) @db.Uuid
  // `normalized()` of the artist name, the one key every artist has.
  nameKey        String   @unique
  name           String
  musicBrainzId  String?
  logo           Bytes?
  logoType       String?
  background     Bytes?
  backgroundType String?
  // When the lookup last ran, hit or miss. Misses are retried sooner than hits
  // are refreshed: an artist nobody has drawn a logo for yet may acquire one,
  // while an artist who has one rarely gets a different one.
  checkedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
